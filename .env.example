# Theocratic Shift Scheduler - Environment Configuration
# Copy to .env and update values for your environment

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/theoshift_scheduler"

# JWT Authentication
JWT_SECRET="use [openssl rand -hex 32] to generate a 32 bytes value"

# Email Configuration
EMAIL_ENCRYPTION_KEY="your-32-character-encryption-key"-here

# Application Settings
NODE_ENV=production
PORT=3001

# Optional: comma-separated bases for the other TheoShift node(s); document downloads fall back here if the file is missing locally (blue-green uploads).
# THEOSHIFT_UPLOAD_PEER_URLS=http://10.92.3.24:3001,http://10.92.3.22:3001
