# Test Environment Configuration for TheoShift
# Copy this file to .env.test and update with your test credentials

# Base URL for testing
BASE_URL=http://localhost:3001

# Test user credentials
TEST_USER_EMAIL=__SET_ME__
TEST_USER_PASSWORD=__SET_ME__

